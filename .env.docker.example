# GoWave Docker Environment Configuration
# Copy to .env and fill in the required values before `docker compose up`.
# Every key here is also passed to the panel container (env_file in docker-compose.yml).
# Moving an existing SQLite install? Run `gowave migrate to-docker` instead: it writes this file for you.

# Panel image and the directory holding docker-compose.yml (shown in the panel's update hint)
GOWAVE_IMAGE=ghcr.io/aaasazan/gowave:latest
GOWAVE_COMPOSE_DIR=/opt/gowave-docker

# Application Ports
APP_PORT=3000
METRICS_PORT=3001

# Required. Private random secret, at least 32 characters:
#   openssl rand -hex 32
APP_SECRET=

# Optional basic auth for /metrics (published on 127.0.0.1 only)
METRICS_USER=
METRICS_PASS=

# PostgreSQL Configuration
POSTGRES_USER=gowave
# Required:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=gowave
POSTGRES_PORT=5432

# Domain Configuration
FRONT_END_DOMAIN=*
PANEL_DOMAIN=localhost:3000
SUB_PUBLIC_DOMAIN=localhost:3000/api/sub

# JWT Lifetime in hours
JWT_AUTH_LIFETIME=12
