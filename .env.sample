# GoWave environment template.
# Copy it to .env in the working directory (GoWave also reads ../.env) and edit.
# Docker Compose installs should start from .env.docker.example instead.
#
# Invalid values stop startup and the log names the offending variable.
# Full reference: https://aaasazan.github.io/gowave-docs/reference/environment/

### REQUIRED ###
# Signs JWTs and participates in password hashes, API tokens and node SSH
# encryption. At least 32 characters. Never change it on a running panel.
#   openssl rand -hex 32
APP_SECRET=

### APP ###
# The panel and metrics listen here. Keep loopback and put Caddy/Nginx with
# HTTPS in front; 0.0.0.0 is only for Docker containers.
APP_HOST=127.0.0.1
APP_PORT=3000

### PANEL AND SUBSCRIPTION URLS ###
# Panel domain without scheme or trailing slash. Used in notification links.
PANEL_DOMAIN=panel.domain.com
# Dashboard mount point only. API, subscriptions and metrics keep their root
# URLs and do not move with the dashboard.
# panel, /panel and /panel/ are equivalent.
PANEL_BASE_PATH=/
# Public subscription base URL, without scheme and without a trailing slash.
# If the subscription page uses a custom prefix, append it here too.
SUB_PUBLIC_DOMAIN=panel.domain.com/api/sub
# CORS allowlist. * allows any origin.
FRONT_END_DOMAIN=*
# Administrator session lifetime, hours.
JWT_AUTH_LIFETIME=12

### SUBSCRIPTION LINKS ###
# Length of the random short UUID in subscription links (16-64).
SHORT_UUID_LENGTH=16

### DATABASE ###
# Native/systemd only. The Docker project sets DB_DRIVER=postgres and
# DATABASE_URL itself in docker-compose.yml, overriding these values.
#
# sqlite (default) or postgres. When DB_DRIVER is unset, a postgres:// or
# postgresql:// DATABASE_URL selects PostgreSQL; anything else uses SQLite.
DB_DRIVER=sqlite
# SQLite file path:
DATABASE_URL=gowave.db
# PostgreSQL instead of SQLite:
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://gowave:password@127.0.0.1:5432/gowave?sslmode=disable
# PostgreSQL connection pool size (1-500). Ignored by SQLite.
# DB_MAX_CONNECTIONS=20

### SERVICE LOG ###
# LOG_LEVEL: debug, info, warn or error.
# LOG_FORMAT: text (journalctl, docker compose logs) or json (log collectors).
LOG_LEVEL=info
LOG_FORMAT=text
# Log every HTTP request, including subscription fetches. Very noisy on a
# loaded panel, so it is off by default.
IS_HTTP_LOGGING_ENABLED=false

### PROMETHEUS METRICS ###
# The panel enables the metrics port unless this is false. install.sh writes
# false; set true only when a Prometheus scraper needs it.
METRICS_ENABLED=false
METRICS_PORT=3001
# Basic auth for /metrics. While either value is empty, /metrics returns 401.
METRICS_USER=
METRICS_PASS=

### SERVICE BEHAVIOUR ###
# Clear per-user traffic history weekly (Monday 00:30 UTC).
SERVICE_CLEAN_USAGE_HISTORY=false
# Do not record per-user traffic statistics.
SERVICE_DISABLE_USER_USAGE_RECORDS=false
# Do not record subscription request history.
SERVICE_DISABLE_SRH_RECORDS=false
# Ignore a user's traffic sample when it is smaller than this many bytes.
USER_USAGE_IGNORE_BELOW_BYTES=0
# Compatibility flag only: the API reports it, but GoWave has no Redis Streams
# export. Safe to leave false.
# EXPORT_TO_STREAM_ENABLED=false

### WEBHOOK NOTIFICATIONS ###
WEBHOOK_ENABLED=false
# When WEBHOOK_ENABLED is true, set both WEBHOOK_URL and
# WEBHOOK_SECRET_HEADER.
#
# One or more http:// or https:// URLs, comma-separated.
# WEBHOOK_URL=https://your-webhook-url.com/endpoint
#
# At least 32 Latin letters and digits.
# WEBHOOK_SECRET_HEADER=

### TELEGRAM NOTIFICATIONS ###
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
# Required when Telegram notifications are enabled.
TELEGRAM_BOT_TOKEN=
# Optional custom Bot API server (default https://api.telegram.org).
# TELEGRAM_BOT_API_ROOT=https://api.telegram.org
# Optional proxy: protocol://user:password@host:port
# TELEGRAM_BOT_PROXY=socks5://proxy:1080

# Chat targets in "chatId" or "chatId:threadId" form. An empty value or
# change_me disables that channel.
TELEGRAM_NOTIFY_USERS=
TELEGRAM_NOTIFY_NODES=
TELEGRAM_NOTIFY_CRM=
TELEGRAM_NOTIFY_SERVICE=
TELEGRAM_NOTIFY_TBLOCKER=

### THRESHOLD NOTIFICATIONS ###
# Each list is a JSON array of integers and is read only when its flag is true.
# A missing or invalid list stops startup.
BANDWIDTH_USAGE_NOTIFICATIONS_ENABLED=false
# Traffic-limit percentages, ascending, 25-95, at most 5 values.
BANDWIDTH_USAGE_NOTIFICATIONS_THRESHOLD=[60, 80]

NOT_CONNECTED_USERS_NOTIFICATIONS_ENABLED=false
# Hours after user creation without a connection, ascending, 1-168,
# at most 3 values.
NOT_CONNECTED_USERS_NOTIFICATIONS_AFTER_HOURS=[6, 24, 48]

EXPIRATION_NOTIFICATIONS_ENABLED=false
# Hours relative to user expiry: negative before, positive after, 0 is not
# allowed, range -168..168, at most 5 values per side.
EXPIRATION_NOTIFICATIONS=[-72, -48, -24, 24]

### NOTIFICATION EVENTS ###
# Optional YAML file that enables or disables individual events. Without it,
# GoWave looks in its standard locations and enables every event.
# NOTIFICATIONS_CONFIG_PATH=/etc/gowave/notifications-config.yml

### DOCKER COMPOSE ###
# Docker installations start from .env.docker.example, not this file.
# The panel image is set in docker-compose.yml:
#   image: ghcr.io/aaasazan/gowave:latest
# Change that tag to :dev for the dev channel; the panel does not switch
# Docker channels from its UI. GOWAVE_COMPOSE_DIR is used by the panel's update
# hint. POSTGRES_PASSWORD is required by Docker Compose; POSTGRES_USER,
# POSTGRES_DB and POSTGRES_PORT have defaults.
# The panel itself reads only the resulting DATABASE_URL.
# GOWAVE_COMPOSE_DIR=/opt/gowave-docker
# POSTGRES_USER=gowave
# POSTGRES_PASSWORD=
# POSTGRES_DB=gowave
# POSTGRES_PORT=5432

### REMNAWAVE COMPATIBILITY ###
# A .env migrated from Remnawave may keep these lines; GoWave ignores them:
# REDIS_SOCKET, REDIS_HOST, REDIS_PORT, REDIS_DB, REDIS_PASSWORD,
# API_INSTANCES, EXPORT_TO_STREAM_MAXLEN,
# SHORT_UUID_METHOD, SHORT_UUID_CUSTOM_PATTERN.
# GoWave needs no Redis and runs as a single process.
