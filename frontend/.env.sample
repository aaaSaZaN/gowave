# Optional frontend settings. Copy to frontend/.env to override defaults.
# API requests use the current origin and Vite's /api proxy to localhost:3000.
DOMAIN_BACKEND=
DOMAIN_OVERRIDE=0

# To use a separate API instead, set a full URL and enable DOMAIN_OVERRIDE.
# DOMAIN_BACKEND=https://api.example.com
# DOMAIN_OVERRIDE=1

# Public Telegram chat URL, embedded at build time (HTTP/HTTPS).
TELEGRAM_CHAT_URL=https://telegram.org
