{
  "name": "@gowave/frontend",
  "version": "3.4.4",
  "private": false,
  "homepage": "https://github.com/aaaSaZaN/gowave",
  "bugs": {
    "url": "https://github.com/aaaSaZaN/gowave/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "Gowave Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaaSaZaN/gowave.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --no-orphans --parallel dev:backend dev:frontend",
    "dev:mock": "bun ../scripts/mock-db.mjs --serve",
    "dev:backend": "cd ../backend && go run ./cmd/server",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3333 --strictPort",
    "check": "biome check . --error-on-warnings && biome check --config-path=biome.json --vcs-enabled=false ../scripts/mock-db.mjs --error-on-warnings",
    "fix": "biome check --write . && biome check --config-path=biome.json --vcs-enabled=false --write ../scripts/mock-db.mjs",
    "css:types": "bun scripts/css-types.mjs",
    "typecheck": "bun scripts/css-types.mjs --check && svelte-check --tsgo --tsconfig tsconfig.json --fail-on-warnings && bun ./node_modules/@typescript/native/bin/tsc --project tsconfig.node.json",
    "test": "bun test ./src",
    "test:browser": "bun tests/run-browser.mjs",
    "editor:download": "bun scripts/editor-assets.cjs download",
    "editor:compress": "bun scripts/editor-assets.cjs compress",
    "i18n:types": "bun scripts/translation-resources.mjs && biome format --write @types/resources.ts"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-web": "0.83.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@remnawave/backend-contract": "3.4.17",
    "@remnawave/node-plugins": "0.9.0",
    "@remnawave/subscription-page-types": "0.7.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/svelte-query": "6.4.4",
    "axios": "1.21.1",
    "country-flag-emoji-polyfill": "0.1.10",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "highcharts": "13.1.1",
    "i18next": "27.1.1",
    "jsonc-parser": "3.3.1",
    "jsonrepair": "3.15.0",
    "marked": "14.0.0",
    "modern-screenshot": "4.7.0",
    "monaco-editor": "0.57.0",
    "monaco-yaml": "5.5.1",
    "sv-router": "0.19.0",
    "svelte": "5.58.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "postcss": "8.5.32",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-webfont-dl": "3.14.0"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "sv-router@0.19.0": "patches/sv-router@0.19.0.patch"
  }
}
