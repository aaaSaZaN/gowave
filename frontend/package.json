    "@mantine/dates": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/modals": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@mantine/spotlight": "9.7.4",
    "@monaco-editor/react": "4.7.0",
    "@noble/curves": "2.4.0",
