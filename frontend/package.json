{
  "name": "@gowave/frontend",
  "version": "3.4.4",
  "private": false,
  "homepage": "https://github.com/aaaSaZaN/gowave",
  "bugs": {
    "url": "https://github.com/aaaSaZaN/gowave/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "GoWave Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaaSaZaN/gowave.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --no-orphans --parallel dev:backend dev:frontend",
    "dev:backend": "cd ../backend && go run ./cmd/server",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3333 --strictPort",
    "check": "biome check . --error-on-warnings",
    "fix": "biome check --write .",
    "typecheck": "bun run css:types:check && tsc --noEmit && tsc --project tsconfig.node.json",
    "test": "bun test ./src",
    "test:browser": "bun tests/run-browser.mjs",
    "css:types": "bun scripts/css-types.mjs",
    "css:types:check": "bun scripts/css-types.mjs --check",
    "editor:download": "bun scripts/editor-assets.cjs download",
    "editor:compress": "bun scripts/editor-assets.cjs compress",
    "i18n:types": "bun scripts/translation-resources.mjs && biome format --write @types/resources.ts"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.1",
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/helpers": "0.5.1",
