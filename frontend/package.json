{
  "name": "@gowave/frontend",
  "version": "3.4.4",
  "private": false,
  "homepage": "https://github.com/aaaSaZaN/gowave",
  "bugs": {
    "url": "https://github.com/aaaSaZaN/gowave/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "GoWave Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaaSaZaN/gowave.git"
  },
  "type": "module",
  "scripts": {
    "start:dev": "vite",
    "start:build": "NODE_ENV=production tsc && vite build",
    "cb": "vite build",
    "start:preview": "vite preview --port 3333",
    "serve": "NODE_ENV=production tsc && vite build && vite preview --port 3333",
    "serve:dev": "tsc && vite build && vite preview --port 3333",
    "typecheck": "bun run css:types:check && tsc --noEmit && tsc --project tsconfig.node.json",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicons/logo.svg",
    "toc": "bun scripts/translation-resources.mjs && biome format --write @types/resources.ts",
    "crowdin:download": "crowdin download translations --language=af --branch=dev",
    "crowdin:upload": "crowdin upload sources --branch=dev",
    "format": "biome format . --error-on-warnings",
    "format:fix": "biome format --write .",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write .",
    "check": "biome check . --error-on-warnings",
    "fix": "biome check --write .",
    "build": "vite build",
    "editor:download": "bun scripts/editor-assets.cjs download",
    "editor:compress": "bun scripts/editor-assets.cjs compress",
    "test": "bun test ./src",
    "test:browser": "bun tests/run-browser.mjs",
    "css:types": "bun scripts/css-types.mjs",
    "css:types:check": "bun scripts/css-types.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.1",
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/helpers": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@ebay/nice-modal-react": "1.2.13",
    "@kastov/mantine-datatable": "9.3.4",
    "@kastov/mantine-react-table-open": "9.0.12",
    "@lottiefiles/dotlottie-react": "0.20.0",
    "@lottiefiles/dotlottie-web": "0.81.0",
    "@mantine/code-highlight": "9.7.3",
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/form": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/modals": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@mantine/spotlight": "9.7.3",
    "@monaco-editor/react": "4.7.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@remnawave/backend-contract": "3.4.15",
    "@remnawave/node-plugins": "0.8.3",
    "@remnawave/subscription-page-types": "0.6.2",
    "@scure/bip39": "2.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@virtuoso.dev/masonry": "1.4.3",
    "@xterm/addon-fit": "0.12.0-beta.311",
    "@xterm/addon-unicode11": "0.10.0-beta.310",
    "@xterm/addon-web-links": "0.13.0-beta.310",
    "@xterm/addon-webgl": "0.20.0-beta.309",
    "@xterm/xterm": "6.1.0-beta.315",
    "axios": "1.20.0",
    "country-flag-emoji-polyfill": "0.1.10",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "highcharts": "13.1.1",
    "i18next": "26.5.7",
    "json-edit-react": "2.0.5",
    "jsonc-parser": "3.3.1",
    "jsonrepair": "3.15.0",
    "modern-screenshot": "4.7.0",
    "monaco-editor": "0.57.0",
    "monaco-yaml": "5.5.1",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.5",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "react-router": "8.5.0",
    "react-virtuoso": "4.18.19",
    "react-zoom-pan-pinch": "4.2.0",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "uqr": "0.1.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@crowdin/cli": "5.5.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "postcss": "8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-webfont-dl": "3.13.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@swc/core",
    "core-js-pure"
  ]
}
